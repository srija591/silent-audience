# ---- Core ----
JWT_SECRET=
# Local dev: SQLite file. Production (Render): paste the Postgres "Internal Database URL" - postgres:// and postgresql:// both work.
DATABASE_URL=sqlite:///./silent_audience.db
# Frontend origin(s) allowed to call the API, comma-separated. Use * for local dev only.
CORS_ORIGINS=*

# ---- Demo mode ----
# auto  = mock results when SARVAM_API_KEY is empty, real analysis otherwise
# true  = always mock (safe for demos)   false = always real
MOCK_MODE=auto

# ---- Sarvam AI (speech-to-text + speaker diarization, Batch API) ----
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# verbatim keeps filler words (um, uh) so they can be counted
SARVAM_STT_MODE=verbatim
# en-IN, hi-IN, ta-IN ... (see Sarvam docs for supported codes)
SARVAM_LANGUAGE=en-IN
SARVAM_TIMEOUT_SECONDS=1800

# ---- LLM for semantic analysis + Q&A (OpenAI-compatible chat endpoint) ----
# Defaults use Sarvam's chat API with the same key. Leave LLM_API_KEY empty to reuse SARVAM_API_KEY.
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b
LLM_API_KEY=
